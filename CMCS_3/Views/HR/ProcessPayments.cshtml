@model IEnumerable<CMCS_3.Models.Claim>
@{
    ViewData["Title"] = "Process Payments";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Process Payments</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "HR")">HR Dashboard</a></li>
                    <li class="breadcrumb-item active">Process Payments</li>
                </ol>
            </nav>
        </div>
        <div>
            <button type="button" class="btn btn-success" id="processSelectedBtn" disabled>
                <i class="fas fa-check-circle me-2"></i>Process Selected
            </button>
            <button type="button" class="btn btn-primary" id="exportBtn">
                <i class="fas fa-file-export me-2"></i>Export Report
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Payment Summary Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Pending Payment</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.PendingCount claims</div>
                            <div class="text-muted small">@ViewBag.PendingAmount?.ToString("C")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Processing</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.ProcessingCount claims</div>
                            <div class="text-muted small">@ViewBag.ProcessingAmount?.ToString("C")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-spinner fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Paid This Month</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.PaidCount claims</div>
                            <div class="text-muted small">@ViewBag.PaidAmount?.ToString("C")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Lecturers</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.UniqueLecturers</div>
                            <div class="text-muted small">with pending payments</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Filter & Search</h6>
        </div>
        <div class="card-body">
            <form method="get" action="@Url.Action("ProcessPayments", "HR")" id="filterForm">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="approved" selected="@(ViewBag.SelectedStatus == "approved")">Approved (Ready for Payment)</option>
                            <option value="processing" selected="@(ViewBag.SelectedStatus == "processing")">Processing</option>
                            <option value="paid" selected="@(ViewBag.SelectedStatus == "paid")">Paid</option>
                            <option value="all" selected="@(ViewBag.SelectedStatus == "all")">All</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Department</label>
                        <select name="department" class="form-select">
                            <option value="">All Departments</option>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in ViewBag.Departments)
                                {
                                    <option value="@dept" selected="@(ViewBag.SelectedDepartment == dept)">@dept</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">From Date</label>
                        <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">To Date</label>
                        <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-filter me-1"></i>Apply
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Claims Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Claims Ready for Payment</h6>
            <div>
                <input type="checkbox" id="selectAll" class="form-check-input me-2" />
                <label for="selectAll" class="form-check-label">Select All</label>
            </div>
        </div>
        <div class="card-body">
            <form id="paymentForm" method="post" action="@Url.Action("ProcessBulkPayments", "HR")">
                @Html.AntiForgeryToken()
                <div class="table-responsive">
                    <table class="table table-hover" id="paymentsTable">
                        <thead class="table-light">
                            <tr>
                                <th width="40"><input type="checkbox" id="headerCheckbox" class="form-check-input" /></th>
                                <th>Claim ID</th>
                                <th>Lecturer</th>
                                <th>Department</th>
                                <th>Period</th>
                                <th>Hours</th>
                                <th class="text-end">Amount</th>
                                <th>Status</th>
                                <th>Approved Date</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var claim in Model)
                                {
                                    <tr>
                                        <td>
                                            @if (claim.Status == "Approved")
                                            {
                                                <input type="checkbox" name="selectedClaims" value="@claim.Id" class="form-check-input claim-checkbox" />
                                            }
                                        </td>
                                        <td><strong>@claim.ClaimReference</strong></td>
                                        <td>
                                            <div>@claim.Lecturer?.FullName</div>
                                            <small class="text-muted">@claim.Lecturer?.EmployeeId</small>
                                        </td>
                                        <td>@claim.Lecturer?.Department</td>
                                        <td>@claim.ClaimPeriod.ToString("MMM yyyy")</td>
                                        <td>@claim.TotalHours hrs</td>
                                        <td class="text-end fw-bold">@claim.TotalAmount.ToString("C")</td>
                                        <td>
                                            @switch (claim.Status)
                                            {
                                                case "Approved":
                                                    <span class="badge bg-success">Approved</span>
                                                    break;
                                                case "Processing":
                                                    <span class="badge bg-info">Processing</span>
                                                    break;
                                                case "Paid":
                                                    <span class="badge bg-primary">Paid</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">@claim.Status</span>
                                                    break;
                                            }
                                        </td>
                                        <td>@(claim.ApprovedDate.HasValue ? claim.ApprovedDate.Value.ToString("dd MMM yyyy") : "-")</td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a href="@Url.Action("ClaimDetails", "HR", new { id = claim.Id })" 
                                                   class="btn btn-sm btn-outline-info" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                @if (claim.Status == "Approved")
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-success" 
                                                            onclick="processSinglePayment('@claim.Id')" title="Process Payment">
                                                        <i class="fas fa-money-check"></i>
                                                    </button>
                                                }
                                                @if (claim.Status == "Paid")
                                                {
                                                    <a href="@Url.Action("PaymentReceipt", "HR", new { id = claim.Id })" 
                                                       class="btn btn-sm btn-outline-primary" title="Download Receipt">
                                                        <i class="fas fa-receipt"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4">
                                        <i class="fas fa-file-invoice-dollar fa-3x text-muted mb-3 d-block"></i>
                                        <p class="text-muted">No claims found matching your criteria</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        @if (Model != null && Model.Any())
                        {
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="5"></th>
                                    <th>@Model.Sum(c => c.TotalHours) hrs</th>
                                    <th class="text-end">@Model.Sum(c => c.TotalAmount).ToString("C")</th>
                                    <th colspan="3"></th>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </form>

            <!-- Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                <a class="page-link" href="@Url.Action("ProcessPayments", "HR", new { page = i })">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- Process Payment Modal -->
<div class="modal fade" id="processModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-money-check-alt me-2"></i>Process Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>You are about to process payment for <strong id="selectedCount">0</strong> claim(s).</p>
                <p class="h4 text-success" id="totalPayment">R 0.00</p>
                <hr>
                <div class="mb-3">
                    <label class="form-label">Payment Reference</label>
                    <input type="text" id="paymentReference" class="form-control" placeholder="Enter payment reference" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Payment Date</label>
                    <input type="date" id="paymentDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea id="paymentNotes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmPaymentBtn">
                    <i class="fas fa-check me-1"></i>Confirm Payment
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Select all functionality
            $('#headerCheckbox, #selectAll').change(function() {
                $('.claim-checkbox').prop('checked', $(this).prop('checked'));
                updateProcessButton();
            });

            // Individual checkbox change
            $('.claim-checkbox').change(function() {
                updateProcessButton();
            });

            // Update process button state
            function updateProcessButton() {
                var selectedCount = $('.claim-checkbox:checked').length;
                $('#processSelectedBtn').prop('disabled', selectedCount === 0);
            }

            // Process selected button click
            $('#processSelectedBtn').click(function() {
                var selectedClaims = $('.claim-checkbox:checked');
                var count = selectedClaims.length;
                var total = 0;

                selectedClaims.each(function() {
                    var row = $(this).closest('tr');
                    var amountText = row.find('td:eq(6)').text().replace(/[^0-9.-]+/g, '');
                    total += parseFloat(amountText) || 0;
                });

                $('#selectedCount').text(count);
                $('#totalPayment').text('R ' + total.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,'));
                
                var modal = new bootstrap.Modal(document.getElementById('processModal'));
                modal.show();
            });

            // Confirm payment
            $('#confirmPaymentBtn').click(function() {
                var reference = $('#paymentReference').val();
                var paymentDate = $('#paymentDate').val();
                var notes = $('#paymentNotes').val();

                $('<input>').attr({ type: 'hidden', name: 'paymentReference', value: reference }).appendTo('#paymentForm');
                $('<input>').attr({ type: 'hidden', name: 'paymentDate', value: paymentDate }).appendTo('#paymentForm');
                $('<input>').attr({ type: 'hidden', name: 'notes', value: notes }).appendTo('#paymentForm');

                $('#paymentForm').submit();
            });

            // Export functionality
            $('#exportBtn').click(function() {
                window.location.href = '@Url.Action("ExportPayments", "HR")?' + $('#filterForm').serialize();
            });
        });

        function processSinglePayment(claimId) {
            $('.claim-checkbox').prop('checked', false);
            $('.claim-checkbox[value="' + claimId + '"]').prop('checked', true);
            $('#processSelectedBtn').click();
        }
    </script>
}