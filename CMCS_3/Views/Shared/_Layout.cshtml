<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMCS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-graduation-cap me-2"></i>CMCS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <!-- Home Link - Visible to all -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i>Home
                            </a>
                        </li>

                        <!-- ============================================== -->
                        <!-- LECTURER MENU - Only visible to Lecturers -->
                        <!-- ============================================== -->
                        @if (User.IsInRole("Lecturer"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-file-invoice-dollar me-1"></i>My Claims
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Claims" asp-action="Index">
                                            <i class="fas fa-list me-2"></i>View My Claims
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Claims" asp-action="Create">
                                            <i class="fas fa-plus me-2"></i>Submit New Claim
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Claims" asp-action="History">
                                            <i class="fas fa-history me-2"></i>Claim History
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <!-- ============================================== -->
                        <!-- COORDINATOR MENU - Only visible to Coordinators -->
                        <!-- ============================================== -->
                        @if (User.IsInRole("Coordinator"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-tasks me-1"></i>Coordinator
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Coordinator" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Coordinator" asp-action="PendingClaims">
                                            <i class="fas fa-clock me-2"></i>Pending Claims
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Coordinator" asp-action="ApprovedClaims">
                                            <i class="fas fa-check me-2"></i>Approved Claims
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Coordinator" asp-action="Reports">
                                            <i class="fas fa-chart-bar me-2"></i>Reports
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <!-- ============================================== -->
                        <!-- ACADEMIC MANAGER MENU - Only visible to Managers -->
                        <!-- ============================================== -->
                        @if (User.IsInRole("AcademicManager") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-tie me-1"></i>Manager
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Manager" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Manager" asp-action="ReviewClaims">
                                            <i class="fas fa-search me-2"></i>Review Claims
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Manager" asp-action="Reports">
                                            <i class="fas fa-chart-pie me-2"></i>Reports
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <!-- ============================================== -->
                        <!-- HR MENU - Only visible to HR role -->
                        <!-- ============================================== -->
                        @if (User.IsInRole("HR"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-users-cog me-1"></i>HR Management
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="HR" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>HR Dashboard
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="dropdown-header">Lecturer Management</li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="HR" asp-action="Lecturers">
                                            <i class="fas fa-users me-2"></i>View All Lecturers
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="HR" asp-action="CreateLecturer">
                                            <i class="fas fa-user-plus me-2"></i>Add New Lecturer
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="dropdown-header">Payments</li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="HR" asp-action="ProcessPayments">
                                            <i class="fas fa-money-check-alt me-2"></i>Process Payments
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="HR" asp-action="PaymentHistory">
                                            <i class="fas fa-history me-2"></i>Payment History
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        <!-- ============================================== -->
                        <!-- ADMIN MENU - Only visible to Admins -->
                        <!-- ============================================== -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-cog me-1"></i>Admin
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                            <i class="fas fa-users me-2"></i>Manage Users
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Roles">
                                            <i class="fas fa-user-tag me-2"></i>Manage Roles
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Settings">
                                            <i class="fas fa-sliders-h me-2"></i>System Settings
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Right side - Login/User Info -->
                    <ul class="navbar-nav">
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <div class="container-fluid py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="footer mt-auto py-3 bg-light">
        <div class="container text-center">
            <span class="text-muted">&copy; @DateTime.Now.Year - Contract Monthly Claim System (CMCS)</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>