<Window x:Class="ContractMonthlyClaimSystem2.CoordinatorDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ContractMonthlyClaimSystem2"
        Title="Coordinator Dashboard"
        Height="750"
        Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#007ACC" Padding="20,15">
            <Grid>
                <TextBlock x:Name="lblUserInfo"
                           Text="Welcome, Coordinator!"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Content="Logout"
                        x:Name="btnLogout"
                        HorizontalAlignment="Right"
                        Background="#D32F2F"
                        Foreground="White"
                        Padding="15,8"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Logout_Click"/>
            </Grid>
        </Border>

        <!-- STATISTICS -->
        <Grid Grid.Row="1" Margin="20,20,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Pending Claims" FontSize="12" Foreground="#666"/>
                    <TextBlock x:Name="txtPendingCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="#FF9800"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Approved Today" FontSize="12" Foreground="#666"/>
                    <TextBlock x:Name="txtApprovedCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="#4CAF50"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Rejected Today" FontSize="12" Foreground="#666"/>
                    <TextBlock x:Name="txtRejectedCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="#F44336"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Pending Amount" FontSize="12" Foreground="#666"/>
                    <TextBlock x:Name="txtPendingAmount" Text="R 0.00" FontSize="24" FontWeight="Bold" Foreground="#007ACC"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2" Margin="20,10,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CLAIMS LIST -->
            <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Claims for Review" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cmbStatusFilter"
                                  Width="150"
                                  SelectionChanged="StatusFilter_Changed">
                            <ComboBoxItem Content="Pending Only"/>
                            <ComboBoxItem Content="Under Review"/>
                            <ComboBoxItem Content="Approved"/>
                            <ComboBoxItem Content="Rejected"/>
                            <ComboBoxItem Content="All Claims"/>
                        </ComboBox>
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              x:Name="claimsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              SelectionChanged="ClaimsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Lecturer" Binding="{Binding LecturerName}" Width="150"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=R {0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Hours" Binding="{Binding HoursWorked}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Submission" Binding="{Binding SubmissionDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- CLAIM DETAILS PANEL -->
            <Border Grid.Column="2" Background="White" CornerRadius="5" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="pnlClaimDetails" Visibility="Visible">
                            <TextBlock Text="Claim Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Select a claim from the list to view details and take action." 
                                       Foreground="#666" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="pnlDetailedInfo" Visibility="Collapsed">
                            <TextBlock Text="Claim Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                            <TextBlock Text="Claim ID" Foreground="#666"/>
                            <TextBlock x:Name="txtDetailClaimId" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Lecturer" Foreground="#666"/>
                            <TextBlock x:Name="txtDetailLecturerName"/>
                            <TextBlock Text="Email" Foreground="#666"/>
                            <TextBlock x:Name="txtDetailEmail"/>

                            <!-- STATUS TRACKER -->
                            <TextBlock Text="Status Progress" Foreground="#666" Margin="0,10,0,5"/>
                            <ProgressBar x:Name="claimProgressBar" Height="15" Minimum="0" Maximum="3" Value="0" Foreground="#007ACC" />
                            <TextBlock x:Name="txtDetailStatus" FontWeight="SemiBold" Foreground="#007ACC" Margin="0,5,0,15"/>

                            <TextBlock Text="Description" Foreground="#666"/>
                            <TextBlock x:Name="txtDetailDescription" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="pnlActions" Visibility="Collapsed" Margin="0,20,0,0">
                            <Button x:Name="btnApproveClaim" Content="✓ Approve" Style="{StaticResource ActionButton}" Background="#4CAF50" Click="ApproveClaim_Click"/>
                            <Button x:Name="btnRejectClaim" Content="✗ Reject" Style="{StaticResource ActionButton}" Background="#F44336" Click="RejectClaim_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
